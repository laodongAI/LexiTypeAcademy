{
  "name": "lexitype-academy",
  "productName": "键语学苑",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "LexiType Academy - English Vocabulary & Typing Practice",
  "author": "Your Name",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm --prefix vue-app run dev",
    "build": "npm --prefix vue-app run build",
    "package": "npm --prefix vue-app run package",
    "typecheck": "npm --prefix vue-app run typecheck",
    "lint": "npm --prefix vue-app run lint",
    "legacy:dev:renderer": "vite",
    "legacy:dev:electron": "cross-env VITE_DEV=1 electron ./electron/main.js",
    "legacy:dev": "concurrently \"npm:legacy:dev:renderer\" \"npm:legacy:dev:electron\"",
    "legacy:build:renderer": "vite build",
    "legacy:build": "npm run legacy:build:renderer",
    "legacy:typecheck": "tsc --noEmit",
    "legacy:start": "electron ./electron/main.js",
    "legacy:dist": "npm run legacy:build:renderer && electron-builder",
    "legacy:dist:dir": "npm run legacy:build:renderer && electron-builder --dir",
    "legacy:dist:portable": "npm run legacy:build:renderer && electron-builder --win portable"
  },
  "dependencies": {
    "dexie": "^4.2.1",
    "electron-store": "^8.2.0",
    "inversify": "^7.10.5",
    "mpg123-decoder": "^1.0.3",
    "reflect-metadata": "^0.2.2",
    "sherpa-onnx": "^1.12.17",
    "uuid": "^13.0.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "chart.js": "^4.4.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.0",
    "electron-builder": "^24.6.0",
    "node-stdlib-browser": "^1.3.1",
    "path-browserify": "^1.0.1",
    "playwright": "^1.40.0",
    "postcss": "^8.4.32",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-node-stdlib-browser": "^0.2.1"
  },
  "build": {
    "appId": "com.lexitype.academy",
    "productName": "LexiType Academy",
    "compression": "maximum",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/sherpa/**/*"
    ],
    "extraFiles": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LexiType Academy"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-portable-${version}.${ext}"
    }
  }
}
