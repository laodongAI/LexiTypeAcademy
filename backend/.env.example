# 后端环境变量示例
# 复制为 .env 后按需修改；本地单机默认值可直接运行

# 应用基础配置
APP_NAME=LexiType Academy API
APP_VERSION=0.3.0
APP_ENV=development

# 本地单机监听地址（仅本机可访问，不对外暴露）
# 端口默认 8010：本机 8000 长期被另一个项目（ai-native-quality-platform）占用
APP_HOST=127.0.0.1
APP_PORT=8010

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log

# 允许访问后端的前端来源（本地单机，只放行本机地址）
CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183

# 数据与模型资产目录（相对 backend/ 目录）
DATA_DIR=data
MODELS_DIR=models

# 数据库连接（阶段2启用 SQLite + Alembic）
DATABASE_URL=sqlite:///./data/lexitype.db

# ---------- 语音服务（TTS） ----------
# 默认引擎：melo（中英双语主引擎）
TTS_ENGINE=melo
# TTS 模型目录（相对 backend/）
TTS_MODEL_DIR=models/tts/vits-melo-tts-zh_en
# 推理线程数
TTS_NUM_THREADS=2
# 音频缓存目录（相对 backend/，同时作为静态播放目录）
TTS_CACHE_DIR=data/tts-cache
# 单次合成文本上限（与前端契约一致）
TTS_MAX_CHARS=1000

# ---------- 语音服务（ASR） ----------
# ASR 模型目录（相对 backend/）
ASR_MODEL_DIR=models/asr/sensevoice
# 推理线程数
ASR_NUM_THREADS=2
# 识别语言：auto / zh / en / ja / ko / yue
ASR_LANGUAGE=auto
# 逆文本规整（数字、标点）
ASR_USE_ITN=true

# ---------- 音频工具 ----------
# ffmpeg 可执行文件：默认走系统 PATH，也可填绝对路径
FFMPEG_PATH=ffmpeg
# 上传音频临时目录（相对 backend/）
VOICE_TMP_DIR=data/tmp/voice
