# 前端环境变量示例
# 复制为 .env.local 后按需修改；本地单机默认值即可直接运行

# 语音合成（TTS）服务地址：现由本地 FastAPI 后端提供
VITE_TTS_API_URL=http://127.0.0.1:8010

# 语音识别（ASR）服务地址：现由本地 FastAPI 后端提供
VITE_ASR_API_URL=http://127.0.0.1:8010

# 通用后端基础地址（AI、课程生成、资源工坊等新接口统一走这里）
VITE_API_BASE_URL=http://127.0.0.1:8010

# 请求超时设置（毫秒）
VITE_TTS_TIMEOUT=30000
VITE_ASR_TIMEOUT=60000

# 是否启用 API 缓存
VITE_ENABLE_API_CACHE=true

# 最大重试次数
VITE_MAX_RETRY=3
